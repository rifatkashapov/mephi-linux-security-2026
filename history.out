    1  clear
    2  sudo find / -type f -perm -4000 2>/dev/null
    3  sudo find / -type f -perm -4000 -exec ls -l {} \; 2>/dev/null
    4  ps -eo ruid,euid,pid,user,euser,comm,args | awk 'NR==1 || ($1 == 1234 && $2 == 0)'
    5  sudo sh -c 'echo "SECRET: setuid works:" > /root/setuid_test.txt'
    6  sudo chmod 600 /root/setuid_test.txt
    7  sudo chown root:root /root/setuid_test.txt
    8  sudo ls -l /root/setuid_test.txt
    9  sudo cp /bin/cat /home/user1/cat-suid
   10  sudo chown root:root /home/user1/cat-suid
   11  sudo chmod u+s /home/user1/cat-suid
   12  ls -l /home/user1/cat-suid
   13  sudo ls -l /home/user1/cat-suid
   14  sudo cp /bin/chown /home/user1/chown-cap
   15  sudo chown root:root /home/user1/chown-cap
   16  sudo chmod 755 /home/user1/chown-cap
   17  sudo setcap cap_chown+ep /home/user1/chown-cap
   18  getcap /home/user1/chown-cap
